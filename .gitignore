.env

# tooling/caches
.worktrees/
node_modules/
ps_modules/
.smokestack-cache.json

# aidd / agent-generated artifacts
.agents/
/.aidd/
.claude/
.codex/
.windsurf/
AGENTS.md
CLAUDE.md
opencode.json

# aidd-adjacent run/test outputs
*.pre-crawl-bak
*.tsbuildinfo
artifacts/
crawltest.json
devdocs/
dogfood-output/
screenshots/
scripts/*-error.png
scripts/smoke-cache.json
test-html-report/
test-results/
testResults.xml
upgrade-review/

# generated
# NOTE: backend/drizzle/meta/ is intentionally NOT ignored — the migration
# journal must ship alongside the tracked drizzle/*.sql so a fresh clone can
# migrate (the runner drift-checks journal vs .sql and refuses to start otherwise).
backups/
data/.seeded
# Depth globs, not data/*.db: a test fixture that writes into a data/ subdirectory (deeper's
# collector fixtures write test.db plus a fixture.secrets.json) was stageable for its whole life.
data/**/*.bak
data/**/*.db
data/**/*.db-journal
data/**/*.db-shm
data/**/*.db-wal
data/**/*.db.lock
data/**/*.secrets.json
data/coordinator/
data/exports/
data/migration-history.json
data/run-logs/
data/uploads/
dist/
frontend/dist/

# logs/temp
*.bak
*.log
*.tmp
/tmp/
logs/
nul/

# local config
/spernakit.psd1
# Shared-core rosters live with the one repository that owns the groups, never here. A roster names
# private sibling repositories, this repository is published, and a tracked file here is copied
# into every derived app, so the whole name shape stays ignored.
/*-targets.json
/config/*.json
/config/*.json.backup.*
/config/testing.local.json
!/config/config-schema.json
!/config/example.json

# mock/test data
.lighthouseci/
*.test.log
benchmarks/manifest.*-20*.json
benchmarks/results/
benchmarks/workspaces/
coverage/

# os/ide
.DS_Store
.idea/
.vscode/
*.swo
*.swp
*~
Thumbs.db

# release excludes
docs/internal/
