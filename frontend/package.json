{
	"name": "spernakit-frontend",
	"private": true,
	"author": "NomadicDaddy",
	"description": "Frontend application for Spernakit v3",
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@radix-ui/react-alert-dialog": "1.2.0",
		"@radix-ui/react-avatar": "1.3.0",
		"@radix-ui/react-checkbox": "1.4.0",
		"@radix-ui/react-dialog": "1.3.0",
		"@radix-ui/react-dropdown-menu": "2.2.0",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-popover": "1.3.0",
		"@radix-ui/react-progress": "1.2.0",
		"@radix-ui/react-select": "2.4.0",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.0",
		"@radix-ui/react-tabs": "1.2.0",
		"@radix-ui/react-tooltip": "1.4.0",
		"@tanstack/react-query": "5.104.2",
		"@tanstack/react-table": "9.2.8",
		"@tanstack/react-virtual": "3.14.17",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"lucide-react": "1.55.0",
		"qrcode": "1.5.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-grid-layout": "2.3.0",
		"react-router": "8.4.0",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"spernakit-shared": "workspace:*",
		"tailwind-merge": "3.7.0",
		"web-vitals": "6.2.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/qrcode": "1.5.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"rollup-plugin-visualizer": "7.1.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vite-plugin-compression2": "2.5.3"
	},
	"engines": {
		"bun": ">=1.4.3"
	},
	"packageManager": "bun@1.4.3",
	"scripts": {
		"build": "bunx tsc -p tsconfig.build.json && bunx vite build",
		"dev": "bunx vite --host",
		"stop": "bun run --cwd .. stop:frontend",
		"lint": "bunx eslint . --report-unused-disable-directives --max-warnings 0",
		"lint:fast": "bunx eslint . --cache --cache-location ../node_modules/.cache/eslint-frontend/ --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "bunx eslint . --report-unused-disable-directives --max-warnings 0 --fix",
		"build:analyze": "ANALYZE=true bunx vite build",
		"typecheck": "bunx tsc -p tsconfig.build.json && bunx tsc -p tsconfig.node.json --noEmit",
		"preinstall": "bun ../scripts/require-bun.ts"
	},
	"type": "module"
}
